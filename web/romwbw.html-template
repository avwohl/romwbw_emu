<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>RomWBW Emulator</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.css">
  <style>
    body {
      background: #1a1a2e;
      color: #eee;
      font-family: 'Segoe UI', Arial, sans-serif;
      margin: 0;
      padding: 20px;
    }
    h1 {
      color: #00aaff;
      margin-bottom: 10px;
    }
    #status {
      color: #888;
      margin-bottom: 10px;
      font-size: 14px;
    }
    #terminal-container {
      border: 2px solid #333;
      border-radius: 8px;
      overflow: hidden;
      display: inline-block;
    }
    .controls {
      margin: 15px 0;
    }
    button {
      background: #0066aa;
      color: white;
      border: none;
      padding: 4px 12px;
      margin-right: 8px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 13px;
    }
    button:hover {
      background: #0088cc;
    }
    button:disabled {
      background: #555;
      cursor: not-allowed;
    }
    .file-input {
      margin: 4px 0;
    }
    label {
      display: inline-block;
      margin-right: 8px;
      font-size: 13px;
    }
    .header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .info {
      font-size: 12px;
      color: #666;
    }
    .instructions {
      margin-top: 20px;
      padding: 15px;
      background: #222;
      border-radius: 8px;
      font-size: 13px;
      max-width: 700px;
    }
    .instructions h3 {
      color: #00aaff;
      margin-top: 0;
    }
    .instructions code {
      background: #333;
      padding: 2px 6px;
      border-radius: 3px;
    }
    /* Loading overlay */
    #loading-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.85);
      z-index: 1000;
      justify-content: center;
      align-items: center;
    }
    #loading-overlay.visible {
      display: flex;
    }
    .loading-content {
      background: #1a1a2e;
      border: 2px solid #0066aa;
      border-radius: 12px;
      padding: 30px 50px;
      text-align: center;
      min-width: 350px;
    }
    .loading-content h2 {
      color: #00aaff;
      margin: 0 0 20px 0;
      font-size: 18px;
    }
    .loading-item {
      margin: 12px 0;
      text-align: left;
    }
    .loading-item-label {
      display: flex;
      justify-content: space-between;
      margin-bottom: 4px;
      font-size: 13px;
    }
    .loading-item-name {
      color: #ccc;
    }
    .loading-item-status {
      color: #888;
    }
    .loading-item-status.done {
      color: #0a0;
    }
    .progress-bar {
      height: 8px;
      background: #333;
      border-radius: 4px;
      overflow: hidden;
    }
    .progress-bar-fill {
      height: 100%;
      background: #0066aa;
      width: 0%;
      transition: width 0.1s;
    }
    .progress-bar-fill.done {
      background: #0a0;
    }
    /* Warning modal */
    #warning-modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.7);
      z-index: 1001;
      justify-content: center;
      align-items: center;
    }
    #warning-modal.visible {
      display: flex;
    }
    .warning-content {
      background: #1a1a2e;
      border: 2px solid #cc6600;
      border-radius: 12px;
      padding: 25px 35px;
      max-width: 500px;
      text-align: center;
    }
    .warning-content h3 {
      color: #ffaa00;
      margin: 0 0 15px 0;
    }
    .warning-content p {
      margin: 10px 0;
      line-height: 1.5;
    }
    .warning-content button {
      margin-top: 15px;
      background: #cc6600;
    }
    .warning-content button:hover {
      background: #ee8800;
    }
    .warn-checkbox {
      font-size: 11px;
      margin-left: 4px;
      color: #888;
    }
  </style>
</head>
<body>
  <!-- Manifest disk write warning modal -->
  <div id="warning-modal">
    <div class="warning-content">
      <h3>Disk Write Warning</h3>
      <p>This disk is loaded from the server and may be replaced when the page reloads or the app updates.</p>
      <p>Any changes you make (save files, etc.) could be lost.</p>
      <p>To preserve your changes, use the <strong>Download</strong> button (↓) to save a local copy.</p>
      <button id="warningOkBtn">OK, I understand</button>
    </div>
  </div>

  <!-- Loading overlay -->
  <div id="loading-overlay">
    <div class="loading-content">
      <h2>Loading RomWBW Emulator</h2>
      <div class="loading-item" id="load-rom">
        <div class="loading-item-label">
          <span class="loading-item-name">ROM</span>
          <span class="loading-item-status">waiting</span>
        </div>
        <div class="progress-bar"><div class="progress-bar-fill"></div></div>
      </div>
      <div class="loading-item" id="load-disk0">
        <div class="loading-item-label">
          <span class="loading-item-name">Disk 0</span>
          <span class="loading-item-status">waiting</span>
        </div>
        <div class="progress-bar"><div class="progress-bar-fill"></div></div>
      </div>
      <div class="loading-item" id="load-disk1">
        <div class="loading-item-label">
          <span class="loading-item-name">Disk 1</span>
          <span class="loading-item-status">waiting</span>
        </div>
        <div class="progress-bar"><div class="progress-bar-fill"></div></div>
      </div>
    </div>
  </div>

  <div class="header-row">
    <h1>RomWBW Emulator <a href="https://github.com/avwohl/cpmemu" style="font-size:12px;color:#888;margin-left:10px;">[sources]</a></h1>
    <span id="status" style="color:#888;font-size:14px;">Loading...</span>
    <span class="info">512KB ROM + 512KB RAM | Z80 | v@VERSION@</span>
  </div>

  <div class="controls">
    <div class="file-input">
      <label>ROM:</label>
      <select id="romSelect" style="margin-right:4px;">
        <option value="">-- Select ROM --</option>
        <option value="emu_avw.rom" selected>emu_avw.rom (Emulator HBIOS - recommended)</option>
      </select>
      <input type="file" id="romFile" accept=".rom,.bin" style="width:180px;">
      <label style="margin-left:12px;">Boot:</label><input type="text" id="bootString" placeholder="2=disk, C=CPM" style="width:100px;" value="2">
      <button id="clearNvramBtn" title="Clear boot config set by SYSCONF">Clear</button>
    </div>
    <div class="file-input">
      <label>Disk 0:</label>
      <select id="disk0Select" style="margin-right:4px;">
        <option value="">-- None --</option>
        <option value="__custom__">-- Custom --</option>
        <option value="hd1k_combo.img" selected>hd1k_combo.img (49MB combo)</option>
        <option value="z80cpm_tools.img">z80cpm_tools.img (Tools + R8/W8)</option>
        <option value="hd1k_games.img">hd1k_games.img (Games)</option>
        <option value="hd1k_cpm22.img">hd1k_cpm22.img (CP/M 2.2)</option>
        <option value="hd1k_zsdos.img">hd1k_zsdos.img (ZSDOS)</option>
      </select>
      <select id="disk0Slices" title="Max slices for disk 0">
        <option value="0">Auto</option>
        <option value="1">1 slice</option>
        <option value="2">2 slices</option>
        <option value="4">4 slices</option>
        <option value="6">6 slices</option>
        <option value="8">8 slices</option>
      </select>
      <input type="file" id="disk0File" accept=".img,.dsk" style="width:160px;">
      <button id="downloadDisk0Btn" disabled title="Download modified disk">↓</button>
      <label class="warn-checkbox"><input type="checkbox" id="disk0NoWarn"> Don't warn</label>
    </div>
    <div class="file-input">
      <label>Disk 1:</label>
      <select id="disk1Select" style="margin-right:4px;">
        <option value="">-- None --</option>
        <option value="__custom__">-- Custom --</option>
        <option value="hd1k_combo.img">hd1k_combo.img (49MB combo)</option>
        <option value="z80cpm_tools.img">z80cpm_tools.img (Tools + R8/W8)</option>
        <option value="hd1k_games.img" selected>hd1k_games.img (Games)</option>
        <option value="hd1k_cpm22.img">hd1k_cpm22.img (CP/M 2.2)</option>
        <option value="hd1k_zsdos.img">hd1k_zsdos.img (ZSDOS)</option>
      </select>
      <select id="disk1Slices" title="Max slices for disk 1">
        <option value="0">Auto</option>
        <option value="1">1 slice</option>
        <option value="2">2 slices</option>
        <option value="4">4 slices</option>
        <option value="6">6 slices</option>
        <option value="8">8 slices</option>
      </select>
      <input type="file" id="disk1File" accept=".img,.dsk" style="width:160px;">
      <button id="downloadDisk1Btn" disabled title="Download modified disk">↓</button>
      <label class="warn-checkbox"><input type="checkbox" id="disk1NoWarn"> Don't warn</label>
    </div>
    <div class="file-input">
      <button id="startBtn">Start</button>
      <button id="stopBtn" disabled>Stop</button>
      <label style="margin-left:20px;"><input type="checkbox" id="debugCheckbox"> Debug</label>
    </div>
  </div>

  <div id="terminal-container">
    <div id="terminal"></div>
  </div>

  <div class="instructions">
    <h3>Quick Start</h3>
    <p>1. Click <strong>Start</strong> to boot with default disks</p>
    <p>2. At <code>A&gt;</code> prompt, type <code>DIR</code> to see files, or run a game like <code>ZORK1</code></p>

    <h3>ROM Types</h3>
    <p><code>emu_avw.rom</code> - <strong>Recommended.</strong> Uses emulator's C++ HBIOS. Works with all hd1k disk images.</p>
    <p>This emulator needs a ROM whose bank 0 is the C++ HBIOS proxy. A stock
    RomWBW ROM built for real hardware - <code>SBC_simh_std.rom</code> and the
    like - drives hardware that is not emulated here and produces no output at
    all, so it is not offered. You can still load any ROM with <strong>Choose
    File</strong> next to the ROM list.</p>

    <h3>Disk Images (hd1k format, 8MB)</h3>
    <p><code>hd1k_games.img</code> - Classic games: Colossal Cave Adventure, Castle, Dungeon, Hitchhiker's</p>
    <p><code>hd1k_infocom.img</code> - Infocom text adventures: Zork 1-3, Hitchhiker's Guide, Enchanter trilogy</p>
    <p><code>hd1k_cpm22.img</code> / <code>hd1k_zsdos.img</code> - Operating system disks</p>

    <h3>Boot Options</h3>
    <p><code>2</code> - Boot from disk (drive A:) | <code>C</code> - CP/M from ROM | <code>H</code> - Help</p>
    <p>Units 0/1 are the on-board RAM/ROM memory disks (no OS) - booting <code>0</code> reports "No system image on disk". The first hard disk is unit <code>2</code>. Press <code>D</code> to list disk units, <code>W</code> to save your choice as the autoboot default.</p>

    <h3>File Transfer (R8 / W8)</h3>
    <p><code>R8 FILENAME</code> - import a host file into CP/M (opens a file picker; the file is saved in CP/M as FILENAME).</p>
    <p><code>W8 FILENAME</code> - export a CP/M file: your browser downloads it.</p>
    <p>R8.COM/W8.COM are on <code>hd1k_combo.img</code> (default disk 0, drive A:), <code>hd1k_games.img</code> (default disk 1), <code>hd1k_cpm22.img</code>, and <code>z80cpm_tools.img</code>.</p>

    <h3>Drive Letters & Slices</h3>
    <p>Hard disks are assigned first, then memory disks. The boot slice becomes A:.</p>
    <p><strong>Auto slices:</strong> 1 disk = 8 slices | 2 disks = 4 each | 3+ disks = 2 each</p>
    <p>Use the slice dropdown to override (e.g., set disk 0 to 6 slices for boot 2.4).</p>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xterm-addon-fit@0.8.0/lib/xterm-addon-fit.min.js"></script>
  <script>
    // Must define Module.onLog BEFORE romwbw.js loads to suppress debug output
    var Module = Module || {};
    var emuDebugEnabled = false;
    Module.onLog = function(msg) {
      if (emuDebugEnabled) console.log(msg);
    };
  </script>
  <script src="romwbw.js?v=@VERSION@"></script>
  <script>
    const EMU_VERSION = '@VERSION@';

    // Terminal setup
    const term = new Terminal({
      cols: 80,
      rows: 25,
      cursorBlink: true,
      fontSize: 16,
      fontFamily: 'Consolas, Monaco, monospace',
      theme: {
        background: '#0a0a1a',
        foreground: '#00aaff',
        cursor: '#00aaff'
      }
    });
    const fitAddon = new FitAddon.FitAddon();
    term.loadAddon(fitAddon);
    term.open(document.getElementById('terminal'));
    fitAddon.fit();
    // Point the keyboard at the guest from the start. Without this, focus
    // sits on <body> after load and every Ctrl-letter belongs to the browser
    // until the user happens to click the terminal - a plain Ctrl+R reloads
    // the page and takes the session and the in-memory disks with it, which
    // is exactly the failure the ^R sweep was chasing. xterm.js only claims
    // Ctrl-letters while its textarea has focus.
    // Skipped on touch-primary devices, where focusing a textarea raises the
    // on-screen keyboard over the page before the user has asked for it.
    if (!window.matchMedia || !window.matchMedia('(pointer: coarse)').matches) {
      term.focus();
    }

    const statusDiv = document.getElementById('status');
    const startBtn = document.getElementById('startBtn');
    const stopBtn = document.getElementById('stopBtn');
    const debugCheckbox = document.getElementById('debugCheckbox');
    const romFile = document.getElementById('romFile');
    const disk0File = document.getElementById('disk0File');
    const disk1File = document.getElementById('disk1File');
    const downloadDisk0Btn = document.getElementById('downloadDisk0Btn');
    const downloadDisk1Btn = document.getElementById('downloadDisk1Btn');

    let romLoaded = false;
    let diskLoaded = [false, false];
    // Store disk data so we can reload after ROM changes
    let diskData = [null, null];
    let diskNames = ['', ''];
    // Track which disks are from server (manifest) vs local file upload
    let diskIsManifest = [false, false];

    // Console output from emulator
    Module.onConsoleOutput = function(ch) {
      if (ch === 13) {  // CR
        term.write('\r');  // Just carriage return
      } else if (ch === 10) {  // LF
        term.write('\r\n');  // LF needs CR+LF for xterm
      } else if (ch === 8) {  // Backspace
        term.write('\b \b');
      } else if (ch === 27) {  // ESC - pass through for ANSI sequences
        term.write('\x1b');
      } else if (ch >= 32 && ch < 127) {
        term.write(String.fromCharCode(ch));
      }
    };

    // Status messages from emulator
    Module.onStatus = function(msg) {
      statusDiv.textContent = msg;
    };

    //=========================================================================
    // VDA (Video Display Adapter) callbacks
    //=========================================================================

    // Track VDA cursor separately from terminal cursor
    let vdaCursorRow = 0;
    let vdaCursorCol = 0;
    let vdaAttr = 0x07;
    let vdaFg = 7;
    let vdaBg = 0;

    // ANSI color codes (CGA palette)
    const ansiColors = [
      '#000000', // 0: Black
      '#0000AA', // 1: Blue
      '#00AA00', // 2: Green
      '#00AAAA', // 3: Cyan
      '#AA0000', // 4: Red
      '#AA00AA', // 5: Magenta
      '#AA5500', // 6: Brown/Yellow
      '#AAAAAA', // 7: Light Gray
      '#555555', // 8: Dark Gray
      '#5555FF', // 9: Light Blue
      '#55FF55', // 10: Light Green
      '#55FFFF', // 11: Light Cyan
      '#FF5555', // 12: Light Red
      '#FF55FF', // 13: Light Magenta
      '#FFFF55', // 14: Yellow
      '#FFFFFF'  // 15: White
    ];

    Module.onVdaInit = function(rows, cols) {
      // Initialize video display
      term.clear();
      vdaCursorRow = 0;
      vdaCursorCol = 0;
    };

    Module.onVdaClear = function() {
      term.clear();
      vdaCursorRow = 0;
      vdaCursorCol = 0;
    };

    Module.onVdaSetCursor = function(row, col) {
      vdaCursorRow = row;
      vdaCursorCol = col;
      // Use ANSI escape sequence to position cursor (1-based)
      term.write('\x1b[' + (row + 1) + ';' + (col + 1) + 'H');
    };

    Module.onVdaWriteChar = function(ch, attr) {
      // Apply attribute if different
      if (attr !== vdaAttr) {
        vdaAttr = attr;
        // Convert attribute to ANSI colors (simple: low nibble = fg, high nibble = bg)
        let fg = attr & 0x0F;
        let bg = (attr >> 4) & 0x07;
        term.write('\x1b[' + (30 + (fg & 7)) + ';' + (40 + bg) + 'm');
      }
      if (ch >= 32 && ch < 127) {
        term.write(String.fromCharCode(ch));
      } else if (ch === 13) {
        term.write('\r');
      } else if (ch === 10) {
        term.write('\n');
      }
    };

    Module.onVdaFill = function(row, col, count, ch, attr) {
      // Position cursor and fill with character
      term.write('\x1b[' + (row + 1) + ';' + (col + 1) + 'H');
      const fillChar = (ch >= 32 && ch < 127) ? String.fromCharCode(ch) : ' ';
      term.write(fillChar.repeat(count));
    };

    Module.onVdaScroll = function(lines) {
      if (lines > 0) {
        // Scroll up: use ANSI scroll up
        term.write('\x1b[' + lines + 'S');
      } else if (lines < 0) {
        // Scroll down: use ANSI scroll down
        term.write('\x1b[' + (-lines) + 'T');
      }
    };

    Module.onVdaSetAttr = function(attr) {
      vdaAttr = attr;
      let fg = attr & 0x0F;
      let bg = (attr >> 4) & 0x07;
      term.write('\x1b[' + (30 + (fg & 7)) + ';' + (40 + bg) + 'm');
    };

    Module.onVdaSetColor = function(fg, bg) {
      vdaFg = fg;
      vdaBg = bg;
      term.write('\x1b[' + (30 + (fg & 7)) + ';' + (40 + (bg & 7)) + 'm');
    };

    //=========================================================================
    // Sound callbacks (using Web Audio API)
    //=========================================================================

    let audioContext = null;

    function getAudioContext() {
      if (!audioContext) {
        audioContext = new (window.AudioContext || window.webkitAudioContext)();
      }
      return audioContext;
    }

    Module.onSndReset = function() {
      // Stop all sounds
      if (audioContext) {
        audioContext.close();
        audioContext = null;
      }
    };

    Module.onSndBeep = function(freq, duration_ms) {
      try {
        const ctx = getAudioContext();
        const oscillator = ctx.createOscillator();
        const gainNode = ctx.createGain();

        oscillator.connect(gainNode);
        gainNode.connect(ctx.destination);

        oscillator.type = 'square';  // Retro sound
        oscillator.frequency.value = freq;
        gainNode.gain.value = 0.1;   // Not too loud

        oscillator.start();
        oscillator.stop(ctx.currentTime + duration_ms / 1000);
      } catch (e) {
        // Sound error - ignore
      }
    };

    Module.onSndNote = function(channel, note, duration_ms) {
      // Convert MIDI note number to frequency: f = 440 * 2^((n-69)/12)
      const freq = 440 * Math.pow(2, (note - 69) / 12);
      Module.onSndBeep(freq, duration_ms);
    };

    Module.onSndVolume = function(channel, volume) {
      // Volume control (0-255) - could be used to adjust gain
    };

    //=========================================================================
    // Host File Transfer callbacks (R8/W8 utilities)
    //=========================================================================

    // R8: Request to read a file from host - opens file picker
    Module.onHostFileRequestRead = function(suggestedName) {
      statusDiv.textContent = 'Select a file to upload to CP/M...';

      // Create a temporary file input
      const input = document.createElement('input');
      input.type = 'file';
      input.accept = '*/*';

      input.onchange = function(e) {
        const file = e.target.files[0];
        if (!file) {
          Module._emu_host_file_cancel();
          statusDiv.textContent = 'File transfer cancelled';
          return;
        }

        const reader = new FileReader();
        reader.onload = function(e) {
          const data = new Uint8Array(e.target.result);
          const ptr = Module._malloc(data.length);
          Module.HEAPU8.set(data, ptr);
          Module._emu_host_file_load(ptr, data.length);
          Module._free(ptr);
          statusDiv.textContent = 'Uploaded: ' + file.name + ' (' + data.length + ' bytes)';
        };
        reader.onerror = function() {
          Module._emu_host_file_cancel();
          statusDiv.textContent = 'Error reading file';
        };
        reader.readAsArrayBuffer(file);
      };

      // Dismissing the picker fires no onchange; without this the guest
      // (paused waiting for the pick) would hang forever. After cancel the
      // wait self-clears and R8 sees EOF and aborts cleanly.
      input.oncancel = function() {
        Module._emu_host_file_cancel();
        statusDiv.textContent = 'File transfer cancelled';
      };

      // Trigger the file picker
      input.click();
    };

    // W8: Download a file from CP/M
    Module.onHostFileDownload = function(filename, blob) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      a.style.display = 'none';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      statusDiv.textContent = 'Downloaded: ' + filename + ' (' + blob.size + ' bytes)';
    };

    // Keyboard + paste input to emulator. onData delivers the full resolved
    // sequence for special keys ("\x1b[A" for ArrowUp, "\x1bOP" for F1, etc.,
    // and control keys as their native bytes - Ctrl+C is "\x03"), and is the
    // only path xterm.js routes clipboard paste through (paste arrives
    // pre-normalized CRLF/LF -> CR by xterm.js).
    // Named so the Ctrl+Shift handler below can feed the same sink. xterm
    // 5.3.0 has no public Terminal.input() - it landed after this pin - and
    // Terminal.paste() would run the text through prepareTextForTerminal and
    // bracketTextForPaste, so a synthetic keystroke has to go through here.
    function sendToGuest(data) {
      if (!Module._romwbw_key_input) return;
      for (const ch of data) {
        const code = ch.codePointAt(0);
        if (code > 0xFF) continue;  // drop non-Latin-1 (Unicode paste/IME); CP/M is byte-oriented
        Module._romwbw_key_input(code);
      }
    }
    term.onData(sendToGuest);

    // xterm.js only translates Ctrl+<letter> when NO other modifier is held:
    // evaluateKeyboardEvent's default case takes the plain-Ctrl branch only
    // for !shift && !alt && !meta. With Shift held it produces no key at all,
    // so Terminal._keyDown returns on `!result.key` before reaching its
    // this.cancel() - no preventDefault runs and the BROWSER default fires.
    // Ctrl+Shift+R is a hard reload: it throws away the session and every
    // in-memory disk, and it is one slipped finger away from the Ctrl+R the
    // CCP uses to retype the line. Real terminals ignore Shift for
    // Ctrl+letter, so do the same - cancel the browser action and deliver the
    // plain control byte.
    //
    // The exclusions are combos the BROWSER owns, not the terminal:
    //   V  paste-as-plain-text. This is the only keyboard paste that reaches
    //      xterm.js on Windows/Linux, because plain Ctrl+V is consumed as
    //      0x16; cancelling it would suppress the DOM paste event that
    //      xterm's textarea listener depends on.
    //   C/I/J/K/P  devtools (Ctrl+Shift+C is the element inspector in every
    //      major browser, NOT copy - browser copy is plain Ctrl+C).
    //   N/T/W/Q  window and tab commands.
    // Everything after V in that list is uncancelable by a page anyway; they
    // are named so nobody later assumes this handler is holding them back.
    // Restricting to keyCode 65..90 also keeps our hands off Ctrl+Insert
    // (copy) and Ctrl+Minus/Plus/0 (zoom), which xterm.js deliberately leaves
    // uncancelled.
    const BROWSER_OWNED_CTRL_SHIFT = new Set(['C','I','J','K','N','P','Q','T','V','W']);
    term.attachCustomKeyEventHandler(function(e) {
      if (e.type !== 'keydown') return true;   // also fires for keyup/keypress
      if (!e.ctrlKey || !e.shiftKey || e.altKey || e.metaKey) return true;
      if (e.keyCode < 65 || e.keyCode > 90) return true;
      if (BROWSER_OWNED_CTRL_SHIFT.has(String.fromCharCode(e.keyCode))) return true;
      // Only claim these keys when there is something to lose. The terminal
      // is focused from load, so without this gate Ctrl+Shift+R would be
      // swallowed on a page that has not started yet - and since plain
      // Ctrl+R is already consumed by xterm.js, that would leave no keyboard
      // route to reload at all. Same condition as the beforeunload guard.
      if (!emuRunning() && !anyDiskDirty()) return true;
      e.preventDefault();
      sendToGuest(String.fromCharCode(e.keyCode - 64));  // same byte as plain Ctrl+letter
      // triggerDataEvent does these two for a real keystroke; a synthetic one
      // bypasses it, so a stale selection would survive and the viewport
      // would not follow the guest's output.
      if (term.hasSelection()) term.clearSelection();
      term.scrollToBottom();
      return false;   // xterm.js must not process this event a second time
    });

    // Helper to load ROM data into emulator
    // Returns true if the core accepted the ROM. It returns -1 for an image
    // it cannot run - a corrupt HBIOS configuration block, or one built for a
    // RomWBW release other than the pinned one - and this used to be ignored,
    // so the page reported "ROM loaded" and then sat there with a CPU that
    // could never produce output.
    function loadRomData(data, name) {
      const ptr = Module._malloc(data.length);
      Module.HEAPU8.set(data, ptr);
      const rc = Module._romwbw_load_rom(ptr, data.length);
      Module._free(ptr);
      if (rc !== 0) {
        romLoaded = false;
        statusDiv.textContent = 'ROM rejected: ' + name +
          ' - not a usable emulator ROM (see the browser console for the reason)';
        return false;
      }
      romLoaded = true;
      statusDiv.textContent = 'ROM loaded: ' + name + ' (' + data.length + ' bytes)';
      // ROM load resets emulator state, so reload any stored disks
      reloadDisks();
      return true;
    }

    // Helper to load disk data into emulator
    // isManifest: true if loaded from server dropdown (can be auto-updated)
    function loadDiskData(unit, data, name, isManifest = false) {
      // Store disk data so we can reload after ROM changes
      diskData[unit] = data;
      diskNames[unit] = name;
      diskIsManifest[unit] = isManifest;
      // Actually load into emulator
      const ptr = Module._malloc(data.length);
      Module.HEAPU8.set(data, ptr);
      Module._romwbw_load_disk(unit, ptr, data.length);
      Module._free(ptr);
      // Mark as manifest disk in emulator
      if (Module._romwbw_set_disk_is_manifest) {
        Module._romwbw_set_disk_is_manifest(unit, isManifest ? 1 : 0);
      }
      diskLoaded[unit] = true;
      if (unit === 0) downloadDisk0Btn.disabled = false;
      if (unit === 1) downloadDisk1Btn.disabled = false;
      statusDiv.textContent = 'Disk ' + unit + ' loaded: ' + name;
    }

    // Reload stored disk data into emulator (after ROM load resets state)
    function reloadDisks() {
      for (let unit = 0; unit < 2; unit++) {
        if (diskData[unit]) {
          const ptr = Module._malloc(diskData[unit].length);
          Module.HEAPU8.set(diskData[unit], ptr);
          Module._romwbw_load_disk(unit, ptr, diskData[unit].length);
          Module._free(ptr);
          // Re-mark as manifest disk
          if (Module._romwbw_set_disk_is_manifest) {
            Module._romwbw_set_disk_is_manifest(unit, diskIsManifest[unit] ? 1 : 0);
          }
        }
        // Re-apply "Don't warn" too.  romwbw_load_rom() deletes the whole
        // EmulatorState and news a fresh one, so every DiskInfo comes back
        // default-constructed with is_manifest AND warning_suppressed false.
        // Restoring only the first is what let a mid-session ROM change
        // silently re-arm a warning the user had already dismissed: the ROM
        // select's change handler reaches this function but never reaches the
        // start path, which is where the checkboxes were otherwise applied.
        // Pushed outside the diskData guard on purpose - the flag is per unit
        // and closeDisk() does not clear it, so setting it for an empty unit
        // still holds when a disk is loaded there later.  The checkbox is the
        // single source of truth, matching the start path.
        if (Module._romwbw_set_disk_warning_suppressed) {
          const noWarn = document.getElementById('disk' + unit + 'NoWarn');
          if (noWarn) {
            Module._romwbw_set_disk_warning_suppressed(unit, noWarn.checked ? 1 : 0);
          }
        }
      }
    }

    //=========================================================================
    // UI settings persistence (localStorage)
    //
    // Persists the control selections (ROM, disks, slices, boot string,
    // warning suppression) across reloads. Local file uploads cannot be
    // restored (browsers forbid programmatic file-input values), so
    // '__custom__' / empty selections are stored as null and the markup
    // default applies on reload. The Debug checkbox is deliberately not
    // persisted (session diagnostic).
    //=========================================================================
    const SETTINGS_KEY = 'romwbw_emu_ui';

    function saveSettings() {
      const sel = id => document.getElementById(id).value;
      const nullIfUnrestorable = v => (!v || v === '__custom__') ? null : v;
      const s = {
        v: 1,
        rom: nullIfUnrestorable(sel('romSelect')),
        bootString: sel('bootString'),
        disk0: nullIfUnrestorable(sel('disk0Select')),
        disk0Slices: sel('disk0Slices'),
        disk0NoWarn: document.getElementById('disk0NoWarn').checked,
        disk1: nullIfUnrestorable(sel('disk1Select')),
        disk1Slices: sel('disk1Slices'),
        disk1NoWarn: document.getElementById('disk1NoWarn').checked,
      };
      try {
        localStorage.setItem(SETTINGS_KEY, JSON.stringify(s));
      } catch (e) { /* Safari private mode / file:// - persistence unavailable */ }
    }

    function restoreSettings() {
      let s;
      try {
        s = JSON.parse(localStorage.getItem(SETTINGS_KEY));
      } catch (e) { return; }
      if (!s || s.v !== 1) return;
      // Apply select values only if the option still exists (a stale value
      // would silently become '' and e.g. turn a disk into None). No change
      // events are dispatched: nothing is fetched here - Start re-reads the
      // live control state and fetches what it needs.
      function setSelect(id, val) {
        if (!val) return;
        const el = document.getElementById(id);
        if ([...el.options].some(o => o.value === val)) el.value = val;
      }
      setSelect('romSelect', s.rom);
      setSelect('disk0Select', s.disk0);
      setSelect('disk0Slices', s.disk0Slices);
      setSelect('disk1Select', s.disk1);
      setSelect('disk1Slices', s.disk1Slices);
      // Restore the boot string whenever the field was saved, including ''
      // (a cleared boot box stays cleared across reloads)
      if (typeof s.bootString === 'string') {
        document.getElementById('bootString').value = s.bootString;
      }
      document.getElementById('disk0NoWarn').checked = !!s.disk0NoWarn;
      document.getElementById('disk1NoWarn').checked = !!s.disk1NoWarn;
    }

    restoreSettings();

    // fetch() resolves for 404 and 500 as well, so reading the body without
    // checking the status hands the emulator the error page as if it were a
    // ROM or a disk image. Everything that pulls a file off the server goes
    // through this. (fetchWithProgress, used by the autostart path, already
    // checks response.ok.)
    function fetchChecked(url) {
      return fetch(url).then(function(r) {
        if (!r.ok) throw new Error('HTTP ' + r.status + ' for ' + url);
        return r.arrayBuffer();
      });
    }

    // Load ROM from server select
    document.getElementById('romSelect').addEventListener('change', function(e) {
      const filename = e.target.value;
      saveSettings();
      if (!filename) return;
      statusDiv.textContent = 'Loading ' + filename + '...';
      fetchChecked(filename)
        .then(buf => {
          loadRomData(new Uint8Array(buf), filename);
          romFile.value = '';  // Clear file input
        })
        .catch(err => { statusDiv.textContent = 'Error loading ROM: ' + err; });
    });

    // Load ROM file from local
    romFile.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        loadRomData(new Uint8Array(e.target.result), file.name);
        document.getElementById('romSelect').value = '';  // Clear select
        saveSettings();
      };
      reader.readAsArrayBuffer(file);
    });

    // Load disk 0 from server select (manifest disk)
    document.getElementById('disk0Select').addEventListener('change', function(e) {
      const filename = e.target.value;
      saveSettings();
      if (!filename || filename === '__custom__') return;
      statusDiv.textContent = 'Loading ' + filename + '...';
      fetchChecked(filename)
        .then(buf => {
          loadDiskData(0, new Uint8Array(buf), filename, true);  // isManifest = true
          disk0File.value = '';
        })
        .catch(err => { statusDiv.textContent = 'Error loading disk: ' + err; });
    });

    // Load disk 0 file from local (user-owned, not manifest)
    disk0File.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        loadDiskData(0, new Uint8Array(e.target.result), file.name, false);  // isManifest = false
        document.getElementById('disk0Select').value = '__custom__';
        saveSettings();
      };
      reader.readAsArrayBuffer(file);
    });

    // Load disk 1 from server select (manifest disk)
    document.getElementById('disk1Select').addEventListener('change', function(e) {
      const filename = e.target.value;
      saveSettings();
      if (!filename || filename === '__custom__') return;
      statusDiv.textContent = 'Loading ' + filename + '...';
      fetchChecked(filename)
        .then(buf => {
          loadDiskData(1, new Uint8Array(buf), filename, true);  // isManifest = true
          disk1File.value = '';
        })
        .catch(err => { statusDiv.textContent = 'Error loading disk: ' + err; });
    });

    // Load disk 1 file from local (user-owned, not manifest)
    disk1File.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        loadDiskData(1, new Uint8Array(e.target.result), file.name, false);  // isManifest = false
        document.getElementById('disk1Select').value = '__custom__';
        saveSettings();
      };
      reader.readAsArrayBuffer(file);
    });

    // Debug checkbox
    debugCheckbox.addEventListener('change', function() {
      emuDebugEnabled = debugCheckbox.checked;  // Control console.log output
      if (Module._romwbw_set_debug) {
        Module._romwbw_set_debug(debugCheckbox.checked ? 1 : 0);
      }
    });

    // "Don't warn" checkboxes for manifest disk write warning
    document.getElementById('disk0NoWarn').addEventListener('change', function() {
      saveSettings();
      if (Module._romwbw_set_disk_warning_suppressed) {
        Module._romwbw_set_disk_warning_suppressed(0, this.checked ? 1 : 0);
      }
    });
    document.getElementById('disk1NoWarn').addEventListener('change', function() {
      saveSettings();
      if (Module._romwbw_set_disk_warning_suppressed) {
        Module._romwbw_set_disk_warning_suppressed(1, this.checked ? 1 : 0);
      }
    });

    // Persist the remaining settings controls ('change' not 'input' for the
    // boot string - it saves on blur/Enter; Start also saves, catching a
    // typed-but-not-blurred value)
    document.getElementById('disk0Slices').addEventListener('change', saveSettings);
    document.getElementById('disk1Slices').addEventListener('change', saveSettings);
    document.getElementById('bootString').addEventListener('change', saveSettings);

    // Warning modal
    const warningModal = document.getElementById('warning-modal');
    document.getElementById('warningOkBtn').addEventListener('click', function() {
      warningModal.classList.remove('visible');
      term.focus();
    });

    // Poll for manifest disk write warning
    let manifestWarningInterval = null;
    function startManifestWarningPolling() {
      if (manifestWarningInterval) return;
      manifestWarningInterval = setInterval(() => {
        if (Module._romwbw_poll_manifest_warning && Module._romwbw_poll_manifest_warning()) {
          warningModal.classList.add('visible');
        }
      }, 500);
    }
    function stopManifestWarningPolling() {
      if (manifestWarningInterval) {
        clearInterval(manifestWarningInterval);
        manifestWarningInterval = null;
      }
    }

    // Loading overlay helpers
    const loadingOverlay = document.getElementById('loading-overlay');

    function showLoading() {
      // Reset all progress bars
      ['load-rom', 'load-disk0', 'load-disk1'].forEach(id => {
        const el = document.getElementById(id);
        el.querySelector('.loading-item-status').textContent = 'waiting';
        el.querySelector('.loading-item-status').classList.remove('done');
        el.querySelector('.progress-bar-fill').style.width = '0%';
        el.querySelector('.progress-bar-fill').classList.remove('done');
      });
      loadingOverlay.classList.add('visible');
    }

    function hideLoading() {
      loadingOverlay.classList.remove('visible');
    }

    function updateLoadingProgress(itemId, percent, status) {
      const el = document.getElementById(itemId);
      const statusEl = el.querySelector('.loading-item-status');
      const fillEl = el.querySelector('.progress-bar-fill');
      statusEl.textContent = status;
      fillEl.style.width = percent + '%';
      if (percent >= 100) {
        statusEl.classList.add('done');
        fillEl.classList.add('done');
      }
    }

    // Fetch with progress tracking
    async function fetchWithProgress(url, itemId) {
      updateLoadingProgress(itemId, 0, 'connecting...');
      const response = await fetch(url);
      if (!response.ok) throw new Error('HTTP ' + response.status);

      const contentLength = response.headers.get('content-length');
      if (!contentLength) {
        // No content-length header, can't track progress
        updateLoadingProgress(itemId, 50, 'downloading...');
        const buf = await response.arrayBuffer();
        updateLoadingProgress(itemId, 100, formatSize(buf.byteLength));
        return new Uint8Array(buf);
      }

      const total = parseInt(contentLength, 10);
      let loaded = 0;
      const reader = response.body.getReader();
      const chunks = [];

      while (true) {
        const {done, value} = await reader.read();
        if (done) break;
        chunks.push(value);
        loaded += value.length;
        const pct = Math.round((loaded / total) * 100);
        updateLoadingProgress(itemId, pct, formatSize(loaded) + ' / ' + formatSize(total));
      }

      // A truncated disk image is worse than a failed one: an 8MB hd1k image
      // that is no longer exactly 8,388,608 bytes silently falls back to
      // hd512 auto-detect with the wrong geometry. Use < (not !==) so
      // Content-Encoding: gzip (decompressed > compressed total) does not
      // false-positive.
      if (total > 0 && loaded < total) {
        throw new Error('Incomplete download: ' + formatSize(loaded) + ' of ' + formatSize(total));
      }

      // Combine chunks
      const result = new Uint8Array(loaded);
      let offset = 0;
      for (const chunk of chunks) {
        result.set(chunk, offset);
        offset += chunk.length;
      }
      updateLoadingProgress(itemId, 100, formatSize(loaded));
      return result;
    }

    function formatSize(bytes) {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }

    // Start button
    startBtn.addEventListener('click', async function() {
      startBtn.disabled = true;
      saveSettings();  // catches a typed-but-not-blurred boot string

      // Check what's selected (empty string = None selected)
      const disk0Selection = document.getElementById('disk0Select').value;
      const disk1Selection = document.getElementById('disk1Select').value;
      const disk0WantNone = (disk0Selection === '');
      const disk1WantNone = (disk1Selection === '');

      // Check if we need to load anything
      const needRom = !romLoaded;
      // Only auto-load if not already loaded AND user didn't select None
      const needDisk0 = !diskLoaded[0] && !disk0WantNone;
      const needDisk1 = !diskLoaded[1] && !disk1WantNone;

      // Show loading overlay if we need to download files
      if (needRom || needDisk0 || needDisk1) {
        showLoading();

        // Mark items that are already loaded or skipped
        if (!needRom) updateLoadingProgress('load-rom', 100, 'cached');
        if (!needDisk0) updateLoadingProgress('load-disk0', 100, disk0WantNone ? 'none' : 'cached');
        if (!needDisk1) updateLoadingProgress('load-disk1', 100, disk1WantNone ? 'none' : 'cached');
      }

      try {
        // Auto-load the selected ROM if none loaded (a selection restored
        // from localStorage has not been fetched yet - honor it rather than
        // clobbering it back to the default)
        if (needRom) {
          const romSel = document.getElementById('romSelect');
          const defaultRom = romSel.value || 'emu_avw.rom';
          const data = await fetchWithProgress(defaultRom, 'load-rom');
          if (!loadRomData(data, defaultRom)) {
            // Starting the CPU on a ROM the core refused just produces a
            // dead terminal; stop here with the reason on screen instead.
            updateLoadingProgress('load-rom', 100, 'rejected');
            return;
          }
          if (!romSel.value) romSel.value = defaultRom;  // reflect the default that was loaded
        }

        // Reload any previously loaded disks (ROM load resets emulator state)
        reloadDisks();

        // Auto-load disk 0 from selection if not already loaded and not "None"
        if (needDisk0 && disk0Selection && disk0Selection !== '__custom__') {
          try {
            const data = await fetchWithProgress(disk0Selection, 'load-disk0');
            loadDiskData(0, data, disk0Selection, true);  // isManifest = true
          } catch (err) {
            updateLoadingProgress('load-disk0', 100, 'failed: ' + err.message);
          }
        }

        // Auto-load disk 1 from selection if not already loaded and not "None"
        if (needDisk1 && disk1Selection && disk1Selection !== '__custom__') {
          try {
            const data = await fetchWithProgress(disk1Selection, 'load-disk1');
            loadDiskData(1, data, disk1Selection, true);  // isManifest = true
          } catch (err) {
            updateLoadingProgress('load-disk1', 100, 'failed: ' + err.message);
          }
        }
      } catch (err) {
        hideLoading();
        statusDiv.textContent = 'Error loading: ' + err;
        startBtn.disabled = false;
        return;
      }

      hideLoading();
      term.clear();
      term.writeln('RomWBW Emulator v' + EMU_VERSION);
      term.writeln('');

      // Set disk slice counts before starting
      const disk0Slices = parseInt(document.getElementById('disk0Slices').value) || 0;
      const disk1Slices = parseInt(document.getElementById('disk1Slices').value) || 0;
      if (Module._romwbw_set_disk_slices) {
        Module._romwbw_set_disk_slices(0, disk0Slices);
        Module._romwbw_set_disk_slices(1, disk1Slices);
      }

      // Apply warning suppression state from checkboxes
      if (Module._romwbw_set_disk_warning_suppressed) {
        Module._romwbw_set_disk_warning_suppressed(0, document.getElementById('disk0NoWarn').checked ? 1 : 0);
        Module._romwbw_set_disk_warning_suppressed(1, document.getElementById('disk1NoWarn').checked ? 1 : 0);
      }

      // Set boot string if provided
      const bootStr = document.getElementById('bootString').value.trim();
      if (bootStr && Module._romwbw_set_boot_string) {
        // Pass the string to the emulator (allocate temp buffer)
        const len = bootStr.length + 1;
        const ptr = Module._malloc(len);
        for (let i = 0; i < bootStr.length; i++) {
          Module.HEAPU8[ptr + i] = bootStr.charCodeAt(i);
        }
        Module.HEAPU8[ptr + bootStr.length] = 0;  // Null terminate
        Module._romwbw_set_boot_string(ptr);
        Module._free(ptr);
        term.writeln('Auto-boot: ' + bootStr);
      }

      Module._romwbw_start();
      if (debugCheckbox.checked) startDebugMonitor();  // Start monitoring only if debug enabled
      startManifestWarningPolling();  // Start polling for manifest disk write warning
      stopBtn.disabled = false;
      term.focus();
    });

    // Stop button
    stopBtn.addEventListener('click', function() {
      Module._romwbw_stop();
      stopDebugMonitor();  // Stop monitoring
      stopManifestWarningPolling();  // Stop polling for manifest disk write warning
      startBtn.disabled = false;
      stopBtn.disabled = true;
      statusDiv.textContent = 'Stopped';
    });

    // Clear NVRAM button - clears boot config set by ROM's SYSCONF utility
    document.getElementById('clearNvramBtn').addEventListener('click', function() {
      if (Module._romwbw_clear_nvram) {
        Module._romwbw_clear_nvram();
        document.getElementById('bootString').value = '';
        saveSettings();  // the cleared boot box persists across reloads
        statusDiv.textContent = 'NVRAM cleared - boot menu will show';
      }
    });

    // Download disk 0
    downloadDisk0Btn.addEventListener('click', function() {
      const size = Module._romwbw_get_disk_size(0);
      const ptr = Module._romwbw_get_disk_data(0);
      if (ptr && size > 0) {
        const data = new Uint8Array(Module.HEAPU8.buffer, ptr, size);
        const blob = new Blob([data], {type: 'application/octet-stream'});
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'romwbw_disk0.img';
        a.click();
        URL.revokeObjectURL(url);
        if (Module._romwbw_clear_disk_dirty) Module._romwbw_clear_disk_dirty(0);
      }
    });

    // Download disk 1
    downloadDisk1Btn.addEventListener('click', function() {
      const size = Module._romwbw_get_disk_size(1);
      const ptr = Module._romwbw_get_disk_data(1);
      if (ptr && size > 0) {
        const data = new Uint8Array(Module.HEAPU8.buffer, ptr, size);
        const blob = new Blob([data], {type: 'application/octet-stream'});
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'romwbw_disk1.img';
        a.click();
        URL.revokeObjectURL(url);
        if (Module._romwbw_clear_disk_dirty) Module._romwbw_clear_disk_dirty(1);
      }
    });

    // Warn before leaving with a live session, or with guest disk writes that
    // have not been downloaded - in-memory disks vanish with the tab.
    // Downloading a disk clears its dirty flag (a later guest write re-sets
    // it). Dirty state survives Stop, so the warning applies regardless of
    // running state.
    //
    // "Running" is in the guard as well as "dirty" because the keys that end
    // a session are not all cancelable. Ctrl+W, Ctrl+Shift+W and Ctrl+Q are
    // browser-reserved: xterm.js hands the byte to the guest AND the tab
    // closes, and no key handler on this page can stop it. A running CP/M
    // also holds plenty of state that never reaches a disk sector - an editor
    // buffer, a game in progress, a half-typed command line - so waiting for
    // a write before saying anything leaves the common case unprotected.
    function anyDiskDirty() {
      if (typeof Module === 'undefined' || !Module._romwbw_is_disk_dirty) return false;
      for (let u = 0; u < 16; u++) {
        if (Module._romwbw_is_disk_dirty(u)) return true;
      }
      return false;
    }
    function emuRunning() {
      if (typeof Module === 'undefined' || !Module._romwbw_is_running) return false;
      return !!Module._romwbw_is_running();
    }
    window.addEventListener('beforeunload', function(e) {
      if (emuRunning() || anyDiskDirty()) {
        e.preventDefault();
        e.returnValue = '';  // browsers show their own generic prompt
      }
    });

    // Click on terminal to focus it
    document.getElementById('terminal-container').addEventListener('click', function() {
      term.focus();
    });

    // Hand focus back to the guest after a control interaction. Everything in
    // .controls is a fire-and-forget setting; the terminal is the only thing
    // on this page that wants keystrokes, and leaving focus on a button means
    // the next Ctrl-letter is a browser shortcut instead of a CP/M control
    // code (see the load-time focus above).
    //
    // <select> is deliberately NOT included. A closed <select> fires 'change'
    // on every arrow-key press, so refocusing there would yank focus away on
    // the first press and send the second arrow to CP/M as ESC [ B - the user
    // could never reach the second entry of a list by keyboard. Selects hand
    // focus back when the user clicks the terminal.
    function refocusTerminal() { term.focus(); }
    document.querySelectorAll('.controls input[type=file], .controls input[type=checkbox]')
      .forEach(function(el) { el.addEventListener('change', refocusTerminal); });
    document.querySelectorAll('.controls button')
      .forEach(function(el) { el.addEventListener('click', refocusTerminal); });

    // The boot string is a text field: 'change' fires on blur, and stealing
    // focus there would fight a user tabbing to the next control. Hand focus
    // back only on an explicit Enter.
    document.getElementById('bootString').addEventListener('keydown', function(e) {
      if (e.key === 'Enter') { e.preventDefault(); this.blur(); term.focus(); }
    });

    // Debug monitoring - tracks emulator state periodically
    let debugMonitorId = null;
    let lastInstructionCount = 0;
    let noProgressCount = 0;

    function startDebugMonitor() {
      if (debugMonitorId) return;
      lastInstructionCount = 0;
      noProgressCount = 0;
      debugMonitorId = setInterval(() => {
        if (!Module._romwbw_is_running) return;
        const running = Module._romwbw_is_running();
        const waiting = Module._romwbw_is_waiting ? Module._romwbw_is_waiting() : -1;
        const pc = Module._romwbw_get_pc();
        const instr = Module._romwbw_get_instruction_count();
        const progress = instr - lastInstructionCount;

        if (progress === 0) {
          noProgressCount++;
        } else {
          noProgressCount = 0;
        }
        lastInstructionCount = instr;

        if (!running) {
          stopDebugMonitor();
        }
      }, 500);
    }

    function stopDebugMonitor() {
      if (debugMonitorId) {
        clearInterval(debugMonitorId);
        debugMonitorId = null;
      }
    }

    // Wait for WASM to load
    Module.onRuntimeInitialized = function() {
      statusDiv.textContent = 'Ready - Load a ROM or click Start';
      startBtn.disabled = false;
      term.writeln('RomWBW Emulator v' + EMU_VERSION + ' ready.');
      term.writeln('Load a ROM image or click Start to boot.');
      term.writeln('');
    };
  </script>
</body>
</html>
