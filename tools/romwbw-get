def cmd_versions(cat, args):
    runnable = _runnable(args)
    entries = cat.entries()
    stored = load_choice().get("romwbw_version")
    if args.json:
        out = []
        for e in entries:
            d = dict(e)
            d["runnable"] = (runnable is None or e["romwbw_version"] in runnable)
            out.append(d)
        json.dump({"index_url": cat.index_url, "emu_supported": runnable,
                   "selected": stored, "romwbw_versions": out},
                  sys.stdout, indent=2)
        sys.stdout.write("\n")
        return EX_OK

    hidden = 0
    for e in entries:
        v = e["romwbw_version"]
        runs = runnable is None or v in runnable
        if not runs and not args.all:
            hidden += 1
            continue
        marks = []
        if e.get("default"):
            marks.append("index default")
        if v == stored:
            marks.append("selected")
        if not runs:
            marks.append("NOT RUNNABLE by this build")
        print("  %-7s %-8s %-22s %s"
              % (v, e.get("status", "?"), e.get("label", ""),
                 ("(" + ", ".join(marks) + ")") if marks else ""))
    if hidden:
        print("  (%d more this build cannot run; --all shows them)" % hidden)
    # No warning here: _runnable() already said so once, for every subcommand.
    if runnable is not None:
        print("\n  this build runs: %s" % ", ".join(runnable))
    return EX_OK


def cmd_list(cat, args):
    runnable = _runnable(args)
    version = cat.resolve_version(args, None if args.allow_untested else runnable)
    doc = cat.catalog(version)
    roms = [r for r in doc.get("roms", []) if isinstance(r, dict)]
    disks = [d for d in doc.get("disks", []) if isinstance(d, dict)]
    want_roms = args.roms or not (args.roms or args.disks)
    want_disks = args.disks or not (args.roms or args.disks)

    if args.json:
        out = {"romwbw_version": version, "generation": doc.get("generation"),
               "base_url": doc.get("base_url")}
        if want_roms:
            out["roms"] = roms
        if want_disks:
            out["disks"] = disks
        json.dump(out, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return EX_OK

    adir = cat.assets_dir(version)
    print("RomWBW %s  (generation %s)" % (version, doc.get("generation")))
    for label, items, want in (("ROMs", roms, want_roms), ("Disks", disks, want_disks)):
        if not want:
            continue
        print("\n%s:" % label)
        for it in items:
            here = os.path.exists(os.path.join(adir, it.get("filename", "")))
            marks = []
            if it.get("default"):
                marks.append("default")
            if it.get("defaultSlot") is not None:
                marks.append("slot %d" % it["defaultSlot"])
            if it.get("host_transfer"):
                marks.append("R8/W8")
            print("  %-14s %9s  %-8s %s%s"
                  % (it.get("id", "?"), human(it.get("size", 0)),
                     "cached" if here else "",
                     it.get("name", ""),
                     ("  [" + ", ".join(marks) + "]") if marks else ""))
    return EX_OK


def cmd_use(cat, args):
    if args.clear:
        try:
            os.unlink(config_path())
            print("forgot the stored choice; the index default applies again")
        except OSError as e:
            if e.errno != errno.ENOENT:
