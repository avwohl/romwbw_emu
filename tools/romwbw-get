def cmd_fetch(cat, args):
    runnable = _runnable(args)
    version = cat.resolve_version(args, None if args.allow_untested else runnable)
    ids = args.ids or _default_ids(cat, version)
    paths = []
    for ident in ids:
        paths.append(cat.fetch(version, ident, trust_cache=args.trust_cache))
    for p in paths:
        print(p)
    return EX_OK


def _default_ids(cat, version):
    """The ROM plus whatever disks the catalog nominates for slots 0 and 1."""
    ids = ["@rom"]
    doc = cat.catalog(version)
    for slot in (0, 1):
        if any(d.get("defaultSlot") == slot
               for d in doc.get("disks", []) if isinstance(d, dict)):
            ids.append("@disk%d" % slot)
    return ids


def cmd_path(cat, args):
    runnable = _runnable(args)
    version = cat.resolve_version(args, None if args.allow_untested else runnable)
    for ident in args.ids:
        kind, _ = cat.resolve_id(version, ident)
        p = cat.fetch(version, ident, trust_cache=args.trust_cache)
        if args.work and kind == "disk":
            p = cat.working_copy(version, p)
        print(p)
    return EX_OK


def cmd_run(cat, args):
    runnable = _runnable(args)
    version = cat.resolve_version(args, None if args.allow_untested else runnable)
    choice = load_choice()

    rom_id = args.rom or choice.get("rom") or "@rom"
    rom = cat.fetch(version, rom_id, trust_cache=args.trust_cache)

    emu = find_emulator(args.emu)
    if not emu:
        raise Contradiction(
            "no romwbw_emu binary found.  Build it with `make -C src`, or "
            "pass --emu=PATH.")

    argv = [emu, "--romwbw=" + rom]
    for slot in (0, 1):
        ident = getattr(args, "disk%d" % slot) or choice.get("disk%d" % slot)
        if ident is None and not args.no_disks:
            doc = cat.catalog(version)
            if any(d.get("defaultSlot") == slot
                   for d in doc.get("disks", []) if isinstance(d, dict)):
                ident = "@disk%d" % slot
        if not ident or ident == "none":
            continue
        pristine = cat.fetch(version, ident, trust_cache=args.trust_cache)
        argv.append("--disk%d=%s" % (slot, cat.working_copy(version, pristine)))
    argv.extend(args.emu_args)

    info("+ " + " ".join(argv), cat.quiet)
    try:
        os.execv(emu, argv)
    except OSError as e:
        raise Contradiction("could not run %s: %s" % (emu, e))


def cmd_verify(cat, args):
    runnable = _runnable(args)
    versions = ([args.romwbw] if args.romwbw and args.romwbw != "default"
                else [e["romwbw_version"] for e in cat.entries()])
    bad = 0
    checked = 0
    for version in versions:
        adir = cat.assets_dir(version)
        if not os.path.isdir(adir):
            continue
        doc = cat.catalog(version)
        by_name = {}
        for it in list(doc.get("roms", [])) + list(doc.get("disks", [])):
            if isinstance(it, dict) and it.get("filename"):
                by_name[it["filename"]] = it
        # The upstream RomWBW Package.zip is cached here too when
        # roms/build_emu_rom.sh has fetched it, and the catalog carries a
        # sha256 for it.  It is not in roms[] or disks[], so keying only on
        # those two arrays left a verifiable file reported as "not in the
        # catalog" and excluded from the count - a file this program
        # downloaded, and could check, and did not.
        up = doc.get("upstream") or {}
        if up.get("package_url"):
            by_name[up["package_url"].rsplit("/", 1)[-1]] = {
                "id": "@upstream", "sha256": up.get("package_sha256"),
                "size": None}
        for fname in sorted(os.listdir(adir)):
            full = os.path.join(adir, fname)
            # .superseded/ and .partial/ are directories, so os.path.isfile
            # already skips them; listdir does not recurse into either.
            if not os.path.isfile(full):
                continue
            it = by_name.get(fname)
            if it is None:
                print("  ?     %s is not in RomWBW %s's catalog" % (fname, version))
                continue
            checked += 1
            ok, why = cat._verify_cached(full, it.get("size"),
                                         (it.get("sha256") or "").lower(), False)
            if ok:
                print("  ok    %s" % fname)
            elif args.repair:
                print("  fix   %s (%s)" % (fname, why))
                cat._supersede(full)
                cat.fetch(version, it["id"], trust_cache=False)
            else:
                print("  FAIL  %s (%s)" % (fname, why))
                bad += 1
    if not checked:
        print("nothing cached to verify under %s" % cat.cache)
        return EX_OK
    print("\n%s: %d cached asset(s) checked, %d bad"
          % ("FAIL" if bad else "PASS", checked, bad))
    return EX_CONTRADICTION if bad else EX_OK


def cmd_cache_dir(cat, args):
    print(cat.cache)
    return EX_OK


# --- mirror --------------------------------------------------------------------

def cmd_mirror(cat, args):
    """Populate a same-origin directory beside the web page.

    A browser cannot fetch a GitHub release asset: measured, the download URLs
    send no access-control-allow-origin on either redirect hop and the CORS
    preflight 404s, and the images are release assets only, so raw.github and
    jsdelivr 404 on them.  So the page reads a manifest and files served from
    its own origin, and this is what writes them.
    """
    runnable = _runnable(args)
    dest = os.path.abspath(args.dir)
    cdir = os.path.join(dest, "catalog")

    if args.versions == "runnable":
        if runnable is None:
            raise Contradiction(
                "--versions=runnable needs a romwbw_emu binary to ask "
                "(--emu=PATH).  The wasm core and that binary are compiled "
                "from the same src/romwbw_pin.h, so it is the right thing to "
                "ask - but it has to exist.")
        want = [e["romwbw_version"] for e in cat.entries()
                if e["romwbw_version"] in runnable]
        for e in cat.entries():
            if e["romwbw_version"] not in runnable:
                info("skipping RomWBW %s: this build cannot run it - add it "
                     "to ROMWBW_SUPPORTED_RELEASES in src/romwbw_pin.h once "
                     "you have booted it" % e["romwbw_version"], cat.quiet)
    elif args.versions == "all":
        want = [e["romwbw_version"] for e in cat.entries()]
    else:
        want = [v.strip() for v in args.versions.split(",") if v.strip()]
        for v in want:
            cat.entry(v)
    if not want:
        raise Contradiction("no RomWBW version to mirror")

    only = set(v.strip() for v in args.only.split(",")) if args.only else None
    exclude = set(v.strip() for v in args.exclude.split(",")) if args.exclude else set()

    manifest = {
        "schema": MIRROR_SCHEMA,
        "schema_version": MIRROR_SCHEMA_VERSION,
        "interface": INTERFACE,
        "mirrored_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "emu_supported": runnable,
        "source": {"index_url": cat.index_url},
        "romwbw_versions": [],
    }
    kept = set()
    failures = []

    for version in want:
        e = cat.entry(version)
        doc = cat.catalog(version)
        vdir = os.path.join(cdir, INTERFACE, version)
        block = {
            "romwbw_version": version,
            "label": e.get("label", "RomWBW " + version),
            "status": e.get("status"),
            "default": bool(e.get("default")),
            "generation": doc.get("generation"),
            "source": {"base_url": doc.get("base_url"),
                       "release_tag": doc.get("release_tag")},
            "roms": [], "disks": [], "not_mirrored": [],
        }
        for kind, items in (("rom", doc.get("roms", [])),
                            ("disk", doc.get("disks", []))):
            for it in items:
                if not isinstance(it, dict) or not it.get("id"):
                    continue
                ident = it["id"]
                if ident in exclude or (only is not None and ident not in only):
                    block["not_mirrored"].append(
                        {"id": ident, "kind": kind, "name": it.get("name", ""),
                         "size": it.get("size"),
                         "reason": "excluded from this mirror"})
                    continue
                try:
                    src = cat.fetch(version, ident, trust_cache=args.trust_cache)
                except (Contradiction, Unverified) as ex:
                    failures.append("%s %s/%s: %s" % (kind, version, ident, ex))
                    block["not_mirrored"].append(
                        {"id": ident, "kind": kind, "name": it.get("name", ""),
                         "size": it.get("size"), "reason": str(ex)})
                    continue
                fname = it["filename"]
                out = os.path.join(vdir, fname)
                rel = os.path.relpath(out, cdir)
                kept.add(os.path.abspath(out))
                if not (os.path.exists(out)
                        and os.path.getsize(out) == it.get("size")):
                    os.makedirs(vdir, exist_ok=True)
                    info("  mirroring %s" % rel, cat.quiet)
                    tmp = out + ".tmp"
                    _copy(src, tmp)
                    os.replace(tmp, out)
                entry = {k: it[k] for k in
                         ("id", "name", "description", "filename", "size",
                          "sha256", "default", "format", "slices", "defaultSlot",
                          "bootable", "cbios", "host_transfer", "license")
                         if k in it}
                entry["url"] = rel
                block["roms" if kind == "rom" else "disks"].append(entry)
        manifest["romwbw_versions"].append(block)

    if args.prune and os.path.isdir(cdir):
        for root, _dirs, files in os.walk(cdir):
            for f in files:
                p = os.path.abspath(os.path.join(root, f))
                if f == "manifest.json" or p in kept:
                    continue
                info("  pruning %s" % os.path.relpath(p, cdir), cat.quiet)
                _unlink(p)

    # The manifest is the commit point.  It is written last, atomically, so a
    # run that dies halfway leaves the previous one in place and the page keeps
    # working with the set it already had.
    os.makedirs(cdir, exist_ok=True)
    tmp = os.path.join(cdir, "manifest.json.tmp")
    with open(tmp, "w") as f:
        json.dump(manifest, f, indent=2, sort_keys=True)
        f.write("\n")
    os.replace(tmp, os.path.join(cdir, "manifest.json"))

    total = sum(len(b["roms"]) + len(b["disks"]) for b in manifest["romwbw_versions"])
    print("mirrored %d asset(s) for %s into %s"
          % (total, ", ".join(want), cdir))
    if failures:
        for f in failures:
            warn(f)
        return EX_CONTRADICTION
    return EX_OK


_warned_no_emu = [False]


def _runnable(args):
    """Which RomWBW releases the local build can boot, or None if it could not be asked."""
    if getattr(args, "assume_supported", None):
        return [v.strip() for v in args.assume_supported.split(",") if v.strip()]
    emu = find_emulator(args.emu)
    rel = supported_releases(emu)
    if rel is None and not _warned_no_emu[0]:
        # Said once, on every subcommand rather than only on `versions`.  With
        # no answer the release list is not filtered at all, so a user can be
        # handed a 51 MB image for a release their binary will refuse to load -
        # and the refusal happens at the end of the download, not before it.
        _warned_no_emu[0] = True
        if emu:
            warn("%s did not report a supported-release list, so nothing was "
                 "filtered" % emu)
        else:
            warn("no romwbw_emu binary found (build it with `make -C src`, or "
                 "pass --emu=PATH), so the release list was not filtered by "
                 "what this build can run")
    return rel


# --- argument parsing -----------------------------------------------------------

class Parser(argparse.ArgumentParser):
    """argparse, but a usage error exits 64 rather than 2.

    argparse's own error() exits 2, which here is the code that means "could
    not verify - the network was unreachable".  CI acts on that difference:
    .github/workflows/test.yml turns a 2 into a warning and keeps the job
    green.  Left alone, a mistyped flag in that step would be reported as a
    GitHub outage and nothing would go red.
    """

    def error(self, message):
        self.print_usage(sys.stderr)
        self.exit(EX_USAGE, "%s: error: %s\n" % (self.prog, message))


def build_parser():
    p = Parser(
        prog="romwbw-get",
        description="Fetch ROM and disk images from the romwbw_disks catalog.",
        epilog="This repository ships no ROM and no disk image; they are "
               "published at github.com/avwohl/romwbw_disks and fetched here.")
    p.add_argument("--index-url", help="override the compiled-in index URL")
    p.add_argument("--cache", help="cache root (default $XDG_CACHE_HOME/romwbw_emu)")
    p.add_argument("--romwbw", metavar="VER",
                   help="use this RomWBW release for this run ('default' = the index's)")
    p.add_argument("--emu", metavar="PATH",
                   help="the romwbw_emu binary to ask what releases it can run")
    p.add_argument("--assume-supported", metavar="A,B",
                   help="skip asking a binary and assume these releases are runnable")
    p.add_argument("--allow-untested", action="store_true",
                   help="allow a release this build has not been checked against")
    p.add_argument("--offline", action="store_true", help="never open a socket")
    p.add_argument("--refresh", action="store_true", help="ignore the index cache TTL")
    p.add_argument("--trust-cache", action="store_true",
                   help="check cached sizes but not their sha256")
    p.add_argument("--timeout", type=float, default=30.0, metavar="SECS")
    p.add_argument("--retries", type=int, default=1, metavar="N")
    p.add_argument("--quiet", "-q", action="store_true")
    sub = p.add_subparsers(dest="cmd", parser_class=Parser)

    s = sub.add_parser("versions", help="what RomWBW releases are published")
    s.add_argument("--all", action="store_true",
                   help="include releases this build cannot run")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_versions)

    s = sub.add_parser("list", help="what ROMs and disks a release has")
    s.add_argument("--roms", action="store_true")
    s.add_argument("--disks", action="store_true")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_list)

    s = sub.add_parser("use", help="remember a RomWBW release and artifact choice")
    s.add_argument("version", nargs="?")
    s.add_argument("--rom", metavar="ID")
    s.add_argument("--disk0", metavar="ID")
    s.add_argument("--disk1", metavar="ID")
    s.add_argument("--clear", action="store_true", help="forget the stored choice")
    s.set_defaults(func=cmd_use)

    s = sub.add_parser("fetch", help="download and verify assets by id")
    s.add_argument("ids", nargs="*", metavar="ID",
                   help="catalog ids, or @rom / @disk0 / @disk1 / @upstream; "
                        "with none, the release's defaults")
    s.set_defaults(func=cmd_fetch)

    s = sub.add_parser("path", help="print the path of an asset, fetching it if needed")
    s.add_argument("ids", nargs="+", metavar="ID")
    s.add_argument("--work", action="store_true",
                   help="for a disk, print a writable working copy instead of "
                        "the read-only cached original")
    s.set_defaults(func=cmd_path)

    s = sub.add_parser("run", help="fetch what is needed and start the emulator")
    s.add_argument("--rom", metavar="ID")
    s.add_argument("--disk0", metavar="ID")
    s.add_argument("--disk1", metavar="ID")
    s.add_argument("--no-disks", action="store_true", help="boot with no disk attached")
    s.add_argument("emu_args", nargs="*", metavar="-- EMU-ARGS",
                   help="everything after -- is passed to romwbw_emu")
    s.set_defaults(func=cmd_run)

    s = sub.add_parser("mirror", help="populate a same-origin directory for the web page")
    s.add_argument("dir", metavar="DIR")
    s.add_argument("--versions", default="runnable",
                   help="'runnable' (default), 'all', or a comma-separated list")
    s.add_argument("--only", metavar="ID,ID", help="mirror only these ids")
    s.add_argument("--exclude", metavar="ID,ID")
    s.add_argument("--prune", action="store_true",
                   help="delete mirrored files no longer in the manifest")
    s.set_defaults(func=cmd_mirror)

    s = sub.add_parser("verify", help="re-hash everything in the cache")
    s.add_argument("--repair", action="store_true",
                   help="re-download anything that does not verify")
    s.set_defaults(func=cmd_verify)

    s = sub.add_parser("cache-dir", help="print the cache root and exit")
    s.set_defaults(func=cmd_cache_dir)
    return p


def main(argv):
    parser = build_parser()
    # Everything after a bare `--` belongs to the emulator, not to us.
    if "--" in argv:
        cut = argv.index("--")
        argv, passthrough = argv[:cut], argv[cut + 1:]
    else:
        passthrough = []
    args = parser.parse_args(argv)
    if not getattr(args, "cmd", None):
        parser.print_help()
        return EX_USAGE
    if args.cmd == "run":
        args.emu_args = list(args.emu_args) + passthrough
    elif passthrough:
        parser.error("-- is only meaningful for `run`")

    cat = Catalog(args)
    try:
        return args.func(cat, args)
    except Contradiction as e:
        print("romwbw-get: %s" % e, file=sys.stderr)
        return EX_CONTRADICTION
    except Unverified as e:
        print("romwbw-get: CANNOT VERIFY: %s" % e, file=sys.stderr)
        return EX_UNVERIFIED
    except KeyboardInterrupt:
        print("\nromwbw-get: interrupted", file=sys.stderr)
        return EX_UNVERIFIED


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
