#!/usr/bin/env python3
#
# romwbw-plm80 - compile PL/M-80 with Intel's own compiler, under DRI's ISX,
# on the emulator.  Built on tools/romwbw-batch.
#
#   romwbw-plm80 com HELLO.PLM --tools PLM_WORK -o out          -> out/HELLO.COM
#   romwbw-plm80 prl DIR.PLM --tools PLM_WORK --tools UTIL9 \
#                --include UTIL8 -o out                          -> out/DIR.PRL
#
# These are Digital Research's own recipes, run the way DRI ran them.  The
# `com` route is P.SUB / C.SUB from mpm2src/PLM_WORK:
#
#     b:is14
#     :f1:PLM80 $1.PLM debug PAGEWIDTH(80)
#     :f1:link $1.obj,:f1:x0100,:f1:plm80.lib to $1.mod
#     :f1:locate $1.mod code(0100H) stacksize(100) map print($1.tra)
#     :f1:cpm
#     e:objcpm $1
#
# and the `prl` route is PRL.SUB and the PRLA*/PRLB*.SUB files DRI built the
# MP/M II transients with: link and locate the program twice, at 0100H and at
# 0200H, turn both into Intel hex with OBJHEX, go back to CP/M, concatenate the
# two hex files with PIP, clear memory with ZERO and let GENMOD make a page
# relocatable .PRL out of the differences.
#
# The tools stay where the recipes expect them: everything from --tools goes to
# B:, which ISX calls :F1:, and the sources and $INCLUDE files go to A:, which
# is :F0: and the default.  None of these binaries is distributed with this
# repository: --tools names DRI's PLM_WORK directory (ISX.COM, PLM80 and its
# overlays and library, LINK, LINK.OVL, LOCATE, OBJHEX, X0100, X0200,
# OBJCPM.COM, ASM80) and, for `prl`, a directory with GENMOD.COM and
# ZERO.COM (MP/M II's, in mpm2src/UTIL9).  $ISX_TOOLS may list them, colon
# separated.
#
# docs/ISX.md explains ISX and what this machine does for it; docs/BATCH.md
# explains romwbw-batch.
#
# OUTPUTS.  Each run owns the output names it lists (NAME.COM, .SYM, .LIN,
# .TRA or NAME.PRL and the hex files, and each source's .LST and .OBJ) in the
# -o directory, which is `.` unless given.  What the run produced is written
# there; a name it did not produce is removed, so a file an earlier build
# left cannot stand in for this one's; and a build that failed writes only
# its listings (.LST, and LOCATE's .TRA), which say what went wrong - not the
# .COM or .PRL, objects or hex it made.
#
# "Produced" is judged on A:, which is a copy of the system disk and holds
# 95 files of RomWBW's own (3.6.0) - ED.COM, PIP.COM, STAT.COM, LOAD.COM,
# DUMP.COM, SUBMIT.COM.  So before the run each output name is erased from A:
# (the build would replace it anyway), and a file of that name afterwards is
# this run's.  ASSIGN.COM, which the batch runs to swap B: in, cannot go; an
# output of that name counts as produced only if the run changed it.
#
# Exit status: 0 built, with no compiler errors; 1 the build failed or
# reported errors (the console log says where); 2 a tool or file is missing;
# 64 usage; 130 interrupted.

import argparse
import importlib.machinery
import importlib.util
import os
import re
import sys

HERE = os.path.dirname(os.path.abspath(__file__))


def _load_batch():
    # romwbw-batch beside this file - /usr/bin/, installed - and no bytecode
    # cache written beside it: see load_module() there.
    path = os.path.join(HERE, "romwbw-batch")
    loader = importlib.machinery.SourceFileLoader("romwbw_batch", path)
    spec = importlib.util.spec_from_loader("romwbw_batch", loader)
    mod = importlib.util.module_from_spec(spec)
    saved = sys.dont_write_bytecode
    sys.dont_write_bytecode = True
    try:
        loader.exec_module(mod)
    finally:
        sys.dont_write_bytecode = saved
    return mod


rb = _load_batch()

EX_OK, EX_FAILED, EX_ENV, EX_USAGE, EX_INTERRUPTED = 0, 1, 2, 64, 130

ISIS_TOOLS = ["ISX.COM", "PLM80", "PLM80.OV0", "PLM80.OV1", "PLM80.OV2",
              "PLM80.OV3", "PLM80.OV4", "PLM80.LIB", "LINK", "LINK.OVL",
              "LOCATE", "X0100", "OBJCPM.COM"]
PRL_TOOLS = ["OBJHEX", "X0200", "GENMOD.COM"]
ASM_TOOLS = ["ASM80"]


def say(msg):
    print("romwbw-plm80: " + msg, file=sys.stderr)


class Tools(object):
    """The ISIS and CP/M binaries a recipe needs, found in --tools dirs."""

    def __init__(self, dirs):
        self.dirs = [d for d in dirs if d]
        self.files = {}
        for d in self.dirs:
            if not os.path.isdir(d):
                raise rb.UsageError("--tools %s: not a directory" % d)
            for fn in sorted(os.listdir(d)):
                p = os.path.join(d, fn)
                if os.path.isfile(p):
                    self.files.setdefault(fn.upper(), p)

    def need(self, names):
        missing = [n for n in names if n not in self.files]
        if missing:
            raise rb.BatchError(
                "missing from --tools (%s): %s" % (", ".join(self.dirs) or
                                                   "none given",
                                                   " ".join(missing)))

    def has(self, name):
        return name in self.files


def isis_name(path_or_name):
    """The ISIS name a source becomes: 6.3, upper case."""
    base = os.path.basename(path_or_name).upper()
    stem, _, ext = base.partition(".")
    if not re.match(r"^[A-Z0-9]{1,6}$", stem) or len(ext) > 3:
        raise rb.UsageError("%s: an ISIS name is 1-6 letters or digits and a "
                            "3-letter type" % path_or_name)
    return stem, ext


def output_name(name):
    """--name: the CP/M name of the .COM or .PRL, 1-8 letters or digits.

    Only CP/M sees it whole.  The ISIS steps use its first six characters
    (`com`: the located module, which OBJCPM names the .COM after) or five
    (`prl`: NAME1 and NAME2), as DRI did - CONSOLE.PRL was built as CNS1 and
    CNS2 and renamed."""
    n = name.upper()
    if not re.match(r"^[A-Z0-9]{1,8}$", n):
        raise rb.UsageError("--name %s: a CP/M name, 1-8 letters or digits, "
                            "with no type" % name)
    return n


def build_commands(route, sources, name, args):
    """The command lines, and the outputs: (name on the CP/M disk, host name).

    The first output is the one the build is for."""
    f1 = ":F1:"
    objs, cmds = [], ["B:ISX"]
    for src in sources:
        stem, ext = isis_name(src)
        fname = stem + ("." + ext if ext else "")
        if ext == "ASM":
            cmds.append("%sASM80 %s %s" % (f1, fname, args.asm_options))
        else:
            cmds.append("%sPLM80 %s %s" % (f1, fname, args.plm_options))
        objs.append(stem + ".OBJ")

    def link_line(x, mod):
        parts = list(objs)
        if args.x0100 != "none":
            xmod = f1 + x
            if args.x0100 == "first":
                parts.insert(0, xmod)
            else:
                parts.append(xmod)
        parts.append(f1 + "PLM80.LIB")
        return "%sLINK %s TO %s" % (f1, ",".join(parts), mod)

    stack = "STACKSIZE(%s)" % args.stack
    if route == "com":
        stem = name[:6]
        cmds.append(link_line("X0100", stem + ".MOD"))
        cmds.append("%sLOCATE %s.MOD CODE(0100H) %s MAP PRINT(%s.TRA)"
                    % (f1, stem, stack, stem))
        cmds.append(f1 + "CPM")
        cmds.append("B:OBJCPM " + stem)
        outs = [(stem + t, name + t) for t in (".COM", ".SYM", ".LIN", ".TRA")]
    else:
        short = name[:5]
        n1, n2 = short + "1", short + "2"
        cmds.append(link_line("X0100", n1 + ".MOD"))
        cmds.append("%sLOCATE %s.MOD CODE(0100H) %s" % (f1, n1, stack))
        cmds.append("%sOBJHEX %s TO %s.HEX" % (f1, n1, n1))
        cmds.append(link_line("X0200", n2 + ".MOD"))
        cmds.append("%sLOCATE %s.MOD CODE(0200H) %s" % (f1, n2, stack))
        cmds.append("%sOBJHEX %s TO %s.HEX" % (f1, n2, n2))
        cmds.append(f1 + "CPM")
        cmds.append("PIP %s.HEX=%s.HEX,%s.HEX" % (short, n1, n2))
        if not args.no_zero:
            cmds.append("B:ZERO")
        gen = "B:GENMOD %s.HEX %s.PRL" % (short, name)
        if args.data:
            gen += " $" + args.data
        cmds.append(gen)
        outs = [(n, n) for n in (name + ".PRL", n1 + ".HEX", n2 + ".HEX",
                                 short + ".HEX")]
    for src in sources:
        stem, _ = isis_name(src)
        for t in (".LST", ".OBJ"):
            if (stem + t, stem + t) not in outs:
                outs.append((stem + t, stem + t))
    return cmds, outs


# What the tools print when they fail, read out of the binaries that print
# it (strings(1)).  None of it appears on the console of a good build: the
# builds of every MP/M II program in docs/ISX.md were checked for it.  A
# console line matching any of these fails the build.
TOOL_FAILURES = re.compile("|".join([
    # PLM80 and its overlays.  Both the I/O and the fatal error end in
    # COMPILATION TERMINATED, and so do the command-tail errors.
    r"PL/M-80 (?:I/O|FATAL) ERROR", r"COMPILATION TERMINATED",
    r"COMPILER ERROR", r"NOT ENOUGH MEMORY",
    # The ISIS-II library texts, which LINK, LOCATE, OBJHEX and ASM80 print
    # after the name of the file concerned (":F0:HELLO.OBJ, NO SUCH FILE"),
    # and LINK's and LOCATE's own.
    r"NO SUCH FILE", r"DIRECTORY FULL", r"CHECKSUM ERROR", r"PHASE ERROR",
    r"FIXUP BOUNDS ERROR", r"BAD RECORD SEQUENCE", r"ILLEGAL", r"INVALID",
    r"MISSING (?:FILENAME|FILE NAME|EXTENSION)", r"CAN'T ",
    r"COMMAND TAIL ERROR", r"UNRESOLVED EXTERNAL", r"PROGRAM EXCEEDS 64K",
    r"COMMON NOT FOUND", r"\*\*\* ERROR", r"\bERROR\s+\d+",
    # OBJCPM
    r"NO OBJECT FILE", r"DISK FULL", r"BAD LOAD MODULE",
    # GENMOD
    r"RELOC ERROR", r"BAD HEX DIGIT", r"BAD INPUT RECORD",
    # PIP ("NO FILE: =DIR1.HEX"), and ISX's and the BDOS's own
    r"\bNO FILE\b", r"NO DIRECTORY SPACE", r"DISK (?:READ|WRITE) ERROR",
    r"VERIFY ERROR", r"RECORD TOO LONG", r"\bABORTED\b", r"CANNOT ",
    r"NOT FOUND", r"READ ERROR", r"LOAD ERROR", r"Bdos Err",
]))

PLM_BLOCK = re.compile(r"PL/M-80 (?:I/O|FATAL) ERROR")

# What a failed build still writes: PL/M-80's and ASM80's listings and
# LOCATE's map.
LISTINGS = (".LST", ".TRA")

# The command lines themselves, echoed after the CCP's A> or ISX's 0>: a file
# called INVALID.PLM is not an error.
ECHOED_COMMAND = re.compile(r"^(?:[A-P]|\d)>")


def check_console(console):
    """Problems the tools reported on the console, as strings."""
    problems = []
    for m in re.finditer(r"COMPILATION COMPLETE\.\s+(\d+) PROGRAM ERROR", console):
        if int(m.group(1)):
            problems.append("PL/M-80 reported %s program error(s)" % m.group(1))
    for m in re.finditer(r"ASSEMBLY COMPLETE,\s+(\d+) ERROR", console):
        if int(m.group(1)):
            problems.append("ASM80 reported %s error(s)" % m.group(1))
    lines = [l.replace("\x00", "").strip()
             for l in re.split(r"[\r\n]+", console)]
    lines = [l for l in lines if l]
    i = 0
    while i < len(lines):
        line = lines[i]
        i += 1
        if ECHOED_COMMAND.match(line) or not TOOL_FAILURES.search(line):
            continue
        if PLM_BLOCK.match(line):
            # PL/M-80 spreads one error over several lines - which file, its
            # name, the error - and ends with COMPILATION TERMINATED.
            while i < len(lines) and not ECHOED_COMMAND.match(lines[i]):
                line += " " + lines[i]
                i += 1
                if "COMPILATION TERMINATED" in line:
                    break
        if line not in problems:
            problems.append(line)
    return problems


def build_parser():
    p = rb.Parser(
        prog="romwbw-plm80",
        description="Compile PL/M-80 with Intel's PLM80 V3.1 under DRI's ISX "
                    "on romwbw_emu, by DRI's own recipes.",
        epilog="docs/ISX.md has the background and the recipes line by line.")
    p.add_argument("route", choices=["com", "prl"],
                   help="com: P.SUB, a .COM at 0100H;  prl: PRL.SUB, a page "
                        "relocatable .PRL via GENMOD")
    p.add_argument("sources", nargs="+", metavar="SOURCE",
                   help=".PLM (compiled with PLM80) or .ASM (assembled with "
                        "ASM80) files, linked in this order")
    p.add_argument("--tools", action="append", default=[], metavar="DIR",
                   help="directory holding the ISIS and CP/M tools "
                        "(repeatable; default $ISX_TOOLS)")
    p.add_argument("--include", action="append", default=[], metavar="PATH",
                   help="a file or directory of $INCLUDE files (.LIT) to put "
                        "beside the sources on A:")
    p.add_argument("-n", "--name", help="output name, 1-8 letters or digits "
                                        "(default: the first source's)")
    p.add_argument("--plm-options", default="DEBUG PAGEWIDTH(80)",
                   metavar="OPTS", help="PLM80 controls (default %(default)s)")
    p.add_argument("--asm-options", default="DEBUG", metavar="OPTS",
                   help="ASM80 controls (default %(default)s)")
    p.add_argument("--stack", default="100", metavar="N",
                   help="LOCATE STACKSIZE (default %(default)s)")
    p.add_argument("--x0100", choices=["last", "first", "none"],
                   default="last",
                   help="where the X0100/X0200 externals module goes in the "
                        "link: after the objects as P.SUB has it (last), "
                        "before them as SDIR.SUB has it (first), or not at all "
                        "when a source supplies them (none)")
    p.add_argument("--data", metavar="HEX",
                   help="prl: GENMOD's extra data size, as in ED.SUB's "
                        "`genmod ed.hex xed.prl $1000`")
    p.add_argument("--no-zero", action="store_true",
                   help="prl: skip ZERO before GENMOD, as PIP.SUB and "
                        "SDIR.SUB did")
    p.add_argument("-o", "--out", default=".", metavar="DIR")
    p.add_argument("--timeout", type=int, default=rb.DEFAULT_TIMEOUT)
    p.add_argument("--max-instructions", type=rb.instruction_count,
                   metavar="N",
                   help="passed to the emulator: stop after N Z80 "
                        "instructions (default ten billion); 0 for no limit")
    p.add_argument("--rom", default="@rom", metavar="ID|FILE")
    p.add_argument("--disk", default=rb.DEFAULT_SYSTEM_DISK, metavar="ID|FILE")
    p.add_argument("--emu", metavar="PATH")
    p.add_argument("--offline", action="store_true")
    p.add_argument("--work", metavar="DIR",
                   help="keep the disk images and console.log here")
    p.add_argument("-v", "--verbose", action="store_true")
    p.add_argument("-q", "--quiet", action="store_true")
    return p


# The system disk's files the batch itself runs while it builds, which an
# output of the same name cannot displace: ASSIGN swaps B: in, first and after
# every `CPM`.  (The prl route also runs PIP, but writes only .PRL and .HEX.)
RUNS_FROM_A = ("ASSIGN.COM",)


def clear_outputs(b, outs):
    """Erase the output names from A: before the run, so that what is there
    afterwards is what the run made.

    A: is a copy of the system disk, and an output named like one of its
    files was taken for built when the build made nothing: `--name ED` with
    a LOCATE that failed reported ED.COM produced, and wrote RomWBW's ED.COM
    to -o.  Each such file is erased - the build would replace it anyway -
    except one the batch runs itself, which is kept and returned, name to
    contents, for build() to compare."""
    kept = {}
    have = set(b.names("A"))
    for disk, _ in outs:
        if disk not in have:
            continue
        if disk in RUNS_FROM_A:
            kept[disk] = b.read(disk)
        else:
            b.remove(disk)
    return kept


def include_files(includes):
    """The files --include names: each a file, or a directory of them."""
    files = []
    for inc in includes:
        if os.path.isdir(inc):
            files += [os.path.join(inc, f) for f in sorted(os.listdir(inc))
                      if os.path.isfile(os.path.join(inc, f))
                      and not f.startswith(".")]
        elif os.path.isfile(inc):
            files.append(inc)
        else:
            raise rb.UsageError("--include %s: no such file or directory" % inc)
    for f in files:
        try:
            rb.cpm_name(os.path.basename(f))
        except rb.UsageError:
            raise rb.UsageError("--include: %s is not a CP/M 8.3 name, so no "
                                "$INCLUDE could name it" % f)
    return files


def main(argv):
    args = build_parser().parse_args(argv)
    tool_dirs = list(args.tools)
    if not tool_dirs and os.environ.get("ISX_TOOLS"):
        tool_dirs = os.environ["ISX_TOOLS"].split(os.pathsep)
    b = None
    try:
        try:
            tools = Tools(tool_dirs)
            need = list(ISIS_TOOLS)
            if args.route == "prl":
                need += PRL_TOOLS
                if not args.no_zero:
                    need.append("ZERO.COM")
            if any(s.upper().endswith(".ASM") for s in args.sources):
                need += ASM_TOOLS
            if args.x0100 == "none":
                need = [n for n in need if n not in ("X0100", "X0200")]
            tools.need(need)
            for s in args.sources:
                if not os.path.isfile(s):
                    raise rb.UsageError("%s: no such file" % s)
                isis_name(s)
            name = output_name(args.name or isis_name(args.sources[0])[0])
            if args.data and not re.match(r"^[0-9A-Fa-f]{1,4}$", args.data):
                raise rb.UsageError("--data wants a hex number, e.g. 1000")
            cmds, outs = build_commands(args.route, args.sources, name, args)
            includes = include_files(args.include)
            owned = {d for d, _ in outs}
            for p in includes:
                n = rb.cpm_name(os.path.basename(p))
                if n in owned:
                    raise rb.UsageError("--include: %s is a name this build "
                                        "writes itself" % n)

            b = rb.Batch(workdir=args.work, rom=args.rom, system=args.disk,
                         emulator=args.emu, offline=args.offline, isx=True,
                         timeout=args.timeout, verbose=args.verbose,
                         max_instructions=args.max_instructions)
            for n in sorted(tools.files):
                b.add(tools.files[n], n, drive="B")
            for p in includes:
                b.add(p, None, "A", text=True)
            for s in args.sources:
                b.add(s, None, "A", text=True)
            kept = clear_outputs(b, outs)
        except rb.UsageError as e:
            say(str(e))
            return EX_USAGE
        except rb.BatchError as e:
            say(str(e))
            return EX_ENV
        except OSError as e:
            say(rb.os_error(e))
            return EX_ENV
        return build(b, cmds, outs, args, kept)
    except KeyboardInterrupt:
        say("interrupted")
        return EX_INTERRUPTED
    finally:
        # The scratch directory holds two 8 MB disk images; --work keeps it.
        if b is not None:
            b.cleanup()


def build(b, cmds, outs, args, kept=None):
    """Run the build and write its outputs.  `kept` is clear_outputs()'s:
    output names A: still held when the run began, with their contents."""
    kept = kept or {}
    r = b.run(cmds)
    with open(os.path.join(b.workdir, "console.log"), "w",
              encoding="latin-1") as f:
        f.write(r.console)
    status = EX_OK
    problems = list(r.problems) + check_console(r.console)
    for p in problems:
        say(p)
    if not r.completed:
        say("the build did not complete; the console ended with:")
        print(r.tail(), file=sys.stderr)
        status = EX_FAILED

    # What THIS run made on A:.  Asking the -o directory instead is what let
    # a rebuild that failed at its first step report success: the output an
    # earlier build left there was still there.  And asking only whether A:
    # has the name let RomWBW's own ED.COM pass for a failed `--name ED`;
    # clear_outputs() erased those, and a name it had to keep counts only if
    # the run changed it.
    on_disk = set(b.names("A"))
    made = set(d for d, _ in outs if d in on_disk and
               (d not in kept or b.read(d) != kept[d]))
    main_disk, main_host = outs[0]
    if main_disk not in made:
        if main_disk in kept and main_disk in on_disk:
            say("no %s was produced: A: already had %s, which the build runs, "
                "and the run left it as it was" % (main_host, main_disk))
        else:
            say("no %s was produced" % main_host)
        status = EX_FAILED
    elif problems:
        status = EX_FAILED

    os.makedirs(args.out, exist_ok=True)
    written, withheld, removed = [], [], []
    for disk, host in outs:
        dst = os.path.join(args.out, host)
        # A failed build's listings say what went wrong; what else it made -
        # the .COM or .PRL, objects, hex - is not to be mistaken for output.
        if disk in made and (status == EX_OK or host.endswith(LISTINGS)):
            with open(dst, "wb") as f:
                f.write(b.read(disk))
            written.append(dst)
            continue
        if disk in made:
            withheld.append(host)
        if os.path.lexists(dst):
            os.remove(dst)
            removed.append(dst)
    if withheld:
        say("the build failed, so not written: %s" % " ".join(withheld))
    for p in removed:
        say("removed %s, left by an earlier build" % p)
    if not args.quiet:
        for p in written:
            print(p)
        say("%s in %.1fs" % ("built" if status == EX_OK else "FAILED",
                             r.seconds))
    if args.work:
        say("images and console.log kept in %s" % b.workdir)
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
